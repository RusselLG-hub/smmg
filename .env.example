# =============================================================================
# SMMG Environment Variables
# Copy this file to .env and replace every placeholder before client deployment.
# =============================================================================

# Database (Docker Compose overrides this with the internal postgres hostname)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/smmg

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser access
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=smmg
MINIO_SECURE=false

# Email verification (use a verified Resend sender)
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=noreply@your-verified-domain.example

# Seeded administrator
ADMIN_NAME=SMMG Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# AI assistant
AI_GOOGLE_API_KEY=replace-with-your-google-ai-api-key
AI_MODEL=gemini-3.1-flash-lite
