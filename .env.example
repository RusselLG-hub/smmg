# =============================================================================
# SSMG Environment Variables
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ssmg

# --- JWT ---------------------------------------------------------------------
JWT_SECRET=ssmg-secret-key-00-11
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ssmg
MINIO_SECURE=false

# --- Resend ------------------------------------------------------------------
RESEND_API_KEY=re_placeholder_secret_removed
EMAIL_FROM=noreply@ssmg.com

# --- Frontend ----------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# --- AI (future) -------------------------------------------------------------
# AI_API_KEY=your-ai-api-key
# AI_MODEL=your-ai-model

# --- Nuxt (frontend) --------------------------------------------------------
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000

ADMIN_NAME=SSMG Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1234
