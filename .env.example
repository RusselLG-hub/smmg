# =============================================================================
# SMMG Environment Variables
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/smmg

# --- JWT ---------------------------------------------------------------------
JWT_SECRET=smmg-secret-key-00-11
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- MinIO -------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=smmg
MINIO_SECURE=false

# --- Brevo -------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=noreply@smmg.site
EMAIL_FROM_NAME="SMMG"


# --- Frontend ----------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# --- Nuxt (frontend) --------------------------------------------------------
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000

ADMIN_NAME=SMMG Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1234

AI_GOOGLE_API_KEY=your_google_api_key
AI_MODEL=gemini-3.1-flash-lite
